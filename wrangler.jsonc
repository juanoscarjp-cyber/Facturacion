{
  // Cloudflare Worker: sirve la app estática de web/, la API /api/* y los servicios e-CF /fe/*
  "name": "facturacion-rd",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/fe/*", "/FE/*", "/Fe/*"]
  }
}
